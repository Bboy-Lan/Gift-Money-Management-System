{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "礼金簿管理",
  "mainBinaryName": "礼金簿管理",
  "version": "0.3.85",
  "identifier": "com.codex.lijinbook",
  "build": {
    "beforeDevCommand": "npm.cmd run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm.cmd run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "礼金簿管理",
        "width": 390,
        "height": 420,
        "minWidth": 390,
        "minHeight": 420,
        "center": true,
        "maximized": false,
        "fullscreen": false,
        "resizable": false,
        "decorations": false,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-eval'; img-src 'self' data: blob:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "windows": {
      "webviewInstallMode": {
        "type": "fixedRuntime",
        "path": "webview2-fixed"
      }
    }
  }
}
